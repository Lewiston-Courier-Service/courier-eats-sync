{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courier-eats-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CATALOG_AUTO_FIX_ENABLED": "false",
    "ENVIRONMENT": "production"
  },
  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "CATALOG_AUTO_FIX_ENABLED": "true"
      }
    },
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "CATALOG_AUTO_FIX_ENABLED": "false"
      }
    }
  }
}
