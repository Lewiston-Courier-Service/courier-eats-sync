{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courier-eats-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SQUARE_ACCESS_TOKEN",
      "ADMIN_API_KEY"
    ]
  },
  "vars": {
    "CATALOG_AUTO_FIX_ENABLED": "false"
  }
}
