{
  "name": "courier-eats",
  "main": "worker.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "DISPATCH_MODE": "internal",
    "THIRD_PARTY_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DISPATCH_DB",
      "database_name": "courier-eats-dispatch",
      "database_id": "45738ef2-4cc6-4a5c-a624-93d6c242e4df"
    }
  ]
}
